<Window x:Class="Tienda_Abarrotes.View.AgregarProductos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgregarProductos" Height="600" Width="1000" Background="#F4F6F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#0F7A2F" Grid.Column="0">

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Aba-Inventory" Foreground="White" FontSize="20" Margin="10,20,10,20" FontWeight="Bold" HorizontalAlignment="Center"/>

                <Button Content="Inicio" Margin="10"/>
                <Button Content="Productos" Margin="10" Click="btnProductos_Click"/>
                <Button Content="Categorias" Margin="10"/>
                <Button Content="Finanzas" Margin="10"/>
                <Button Content="Configuración" Margin="10"/>

                <Button Content="+ Agregar Producto" Background="#1BBF4C" Foreground="White" Margin="10,20,10,10" 
                        Height="40" FontSize="15" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#0F7A2F"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1BBF4C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Height="40" CornerRadius="6" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnEliminarLateral" Content="- Eliminar producto" Background="#D93025" 
                        Foreground="White" FontWeight="Bold" Height="40" Margin="10,0,10,10" Click="BtnEliminarLateral_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" Margin="10,0,0,15">
                <Button Content="Log out" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="30,20,20,20">
            <StackPanel>
                <TextBlock Text="Agregar Producto" FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Nombre de Producto*" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Height="35" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="5,0"/>

                        <TextBlock Text="Código de Producto*" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Height="35" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                        <TextBlock Text="Tamaño de existencias*" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Height="35" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>
                </Grid>

                <Button Content="Guardar Producto" Background="#1BBF4C" Foreground="White" FontSize="15" FontWeight="Bold"
                        Width="200" Height="45" Margin="0,20,0,0" HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#0F7A2F"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1BBF4C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Width="200" Height="45" CornerRadius="6" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
