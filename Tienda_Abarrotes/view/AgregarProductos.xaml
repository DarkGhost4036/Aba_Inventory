<Window x:Class="Tienda_Abarrotes.View.AgregarProductos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgregarProductos" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- MENU LATERAL -->
        <Grid Background="#0F7A2F" Grid.Column="0">
            <StackPanel>
                <TextBlock Text="Aba-Inventory" Foreground="White" FontSize="20" Margin="10" FontWeight="Bold"/>

                <Button Content="Inicio" Margin="10"/>

                <Button Content="Productos" Margin="10"
                        Click="btnProductos_Click"/>

                <Button Content="Categorias" Margin="10"/>

                <Button Content="Finanzas" Margin="10"/>

                <Button Content="Configuración" Margin="10"/>

        

                <Button Content="+ Agregar Producto" Background="#1BBF4C" Foreground="White" Margin="10" 
                        Height="40" FontSize="15" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"
                                    Value="#0F7A2F"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                            Value="True">
                                    <Setter Property="Background"
                                            Value="#1BBF4C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Height="40"
                                    CornerRadius="6" Margin="0 0 0 0"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="20">
            <StackPanel>
                <TextBlock Text="Add product" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Name*"/>
                        <TextBox Height="35" Margin="0,5,0,15"/>

                        <TextBlock Text="Item code*"/>
                        <TextBox Height="35" Margin="0,5,0,15"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Stock size*"/>
                        <TextBox Height="35" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>
                <Button Content="Save Product" Background="#1BBF4C" Foreground="White" FontSize="15" FontWeight="Bold"
                        Width="200" Height="40">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background"
                                    Value="#0F7A2F"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                            Value="True">
                                    <Setter Property="Background"
                                            Value="#1BBF4C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Width="200" Height="40"
                                    CornerRadius="6" Margin="0 0 0 0"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
