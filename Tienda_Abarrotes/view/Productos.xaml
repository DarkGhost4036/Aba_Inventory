<Window x:Class="Tienda_Abarrotes.View.Productos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productos"
        Height="600" Width="1000"
        Background="#F4F6F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#0F7A2F" Grid.Column="0">

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Aba-Inventory"
                           Foreground="White"
                           FontSize="20"
                           Margin="20"
                           FontWeight="Bold"/>

                <Button Content="Inicio" Margin="10"
                        Click="btnInicio_Click"/>

                <Button Content="Productos" Margin="10"
                        Click="btnProductos_Click"/>

                <Button Content="Categorias" Margin="10"
                        Click="btnCategorias_Click"/>

                <Button Content="Finanzas" Margin="10"
                        Click="btnFinanzas_Click"/>

                <Button Content="Configuración" Margin="10"
                        Click="btnConfiguración_Click"/>

                <Button Content="Gestion de Usuarios" Margin="10"
                        Click="btnManejadorUsuarios_Click"/>

                <Button Content="+ Agregar Producto"
                        Background="#1BBF4C"
                        Foreground="White"
                        Margin="10,20,10,10"
                        Height="40"
                        Click="btnAgregarProducto_Click"/>

                <Button x:Name="BtnEliminarLateral" 
                        Content="- Eliminar producto" 
                        Background="#D93025" 
                        Foreground="White" 
                        Margin="10,0,10,10" 
                        Height="40" 
                        FontWeight="Bold" 
                        Click="BtnEliminarLateral_Click"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" Margin="10,0,0,15">
                <Button Content="Log out" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Producto"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Image Source="https://via.placeholder.com/100"
                   Width="100"
                   Height="100"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding ListaProductos}"
                      AutoGenerateColumns="False"
                      RowHeight="60"
                      CanUserAddRows="False"
                      Background="White"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Imagen" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Imagen}"
                                       Width="50"
                                       Height="50"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Estado" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="5"
                                        CornerRadius="10"
                                        HorizontalAlignment="Center"
                                        Background="Green">
                                    <TextBlock Text="{Binding Estado}"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Producto" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Stock"
                                        Binding="{Binding Stock}"
                                        Width="50"/>

                    <DataGridTextColumn Header="Categoría"
                                        Binding="{Binding Categoria}"
                                        Width="80"/>

                    <DataGridTemplateColumn Header="Cantidad" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <Button Content="-" Width="30" Click="btn_menos_Click"/>

                                    <TextBox x:Name="txtCantidad"
                                             Width="50"
                                             HorizontalContentAlignment="Center"
                                             Margin="5,0"
                                             Text="0"/>
                                    <Button Content="+" Width="30" Click="btn_mas_Click"/>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Acción" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🛒 Agregar"
                                        Background="#1BBF4C"
                                        Foreground="White"
                                        Command="{Binding AgregarCarritoCommand}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
