<Window x:Class="Tienda_Abarrotes.View.VentanaCarritoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tienda_Abarrotes.View"
        xmlns:vm="clr-namespace:Tienda_Abarrotes.ViewModel" 
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Title="Carrito de Compras - Aba Inventory" Height="450" Width="800"
        Background="#0C630D">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Green" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <TextBlock Text="Resumen de Venta" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                <Button Content="Regresar" 
                        Click="btnRegresar_Click"  
                        Background="DarkRed" 
                        Foreground="White" 
                        Width="120" 
                        Padding="5"
                        DockPanel.Dock="Right" 
                        HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding ItemsCarrito}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  Background="Snow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Cant" Binding="{Binding Cantidad}" Width="80"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat={}{0:C}}" Width="100"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,0,0">

            <TextBlock Text="{Binding TotalAPagar, StringFormat='Total a cobrar: {0:C}'}" 
                       FontSize="28" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

            <Button Content="Confirmar Venta y Cobrar" 
                    Command="{Binding FinalizarVentaCommand}"
                    Background="#05AB05" 
                    Foreground="White" 
                    Padding="15,10" 
                    Margin="0,10,0,0"
                    Width="220"
                    HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>